{
  "name": "@plurimath/omml-ts",
  "version": "0.1.0-alpha.0",
  "description": "Portable Office Math models and XML codecs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/generated/index.d.ts",
      "import": "./dist/generated/index.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts.d.ts",
      "import": "./dist/artifacts.js"
    }
  },
  "files": [
    "dist",
    "model",
    "README.md",
    "NOTICE",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node --test test/runtime.test.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "generate": "node scripts/generate-models.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "moxml-ts": "git+https://github.com/lutaml/moxml-ts.git#a78091f7b11bb350fdd18a8dc6e12b3ae39661fd"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  },
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plurimath/omml-ts.git"
  }
}
